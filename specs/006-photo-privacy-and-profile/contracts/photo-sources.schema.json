{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isabelsoares.github.io/myWebSite/specs/006-photo-privacy-and-profile/contracts/photo-sources.schema.json",
  "title": "PhotoSourcesFile",
  "description": "Curated, committed photo metadata. Contains no image bytes and no private absolute paths.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "albums", "featured"],
  "properties": {
    "version": {
      "const": 1
    },
    "albums": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/album"
      }
    },
    "featured": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hero", "portrait"],
      "properties": {
        "hero": {
          "$ref": "#/$defs/photoSource"
        },
        "portrait": {
          "$ref": "#/$defs/photoSource"
        }
      }
    }
  },
  "$defs": {
    "relativeSourcePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$",
      "description": "Path relative to PHOTO_ORIGINALS_DIR. Must not be absolute or contain a parent-directory segment."
    },
    "rotation": {
      "type": "integer",
      "enum": [0, 90, 180, 270],
      "default": 0
    },
    "photoSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "alt"],
      "properties": {
        "source": {
          "$ref": "#/$defs/relativeSourcePath"
        },
        "alt": {
          "type": "string",
          "minLength": 1
        },
        "rotation": {
          "$ref": "#/$defs/rotation"
        },
        "published": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "album": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "photos"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "photos": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/photoSource"
          }
        }
      }
    }
  }
}
