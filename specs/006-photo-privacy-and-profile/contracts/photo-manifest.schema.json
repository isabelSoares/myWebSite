{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isabelsoares.github.io/myWebSite/specs/006-photo-privacy-and-profile/contracts/photo-manifest.schema.json",
  "title": "PhotoManifest",
  "description": "Generated public metadata for approved photo derivatives. Must not contain original filenames, absolute paths, timestamps, or remote image URLs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generatedFrom", "albums", "featured"],
  "properties": {
    "version": {
      "const": 1
    },
    "generatedFrom": {
      "const": "photo-sources.json"
    },
    "albums": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/generatedAlbum"
      }
    },
    "featured": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hero": {
          "$ref": "#/$defs/generatedImage"
        },
        "portrait": {
          "$ref": "#/$defs/generatedImage"
        }
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{12}$"
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src", "width", "height"],
      "properties": {
        "src": {
          "type": "string",
          "pattern": "^photos/generated/(albums/[a-z0-9-]+/[a-f0-9]{12}(-thumb)?\\.webp|featured/[a-z0-9-]+-[a-f0-9]{12}(-thumb)?\\.webp)$"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        }
      }
    },
    "generatedImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceId", "alt", "rotation", "thumbnail", "full"],
      "properties": {
        "id": {
          "$ref": "#/$defs/hash"
        },
        "sourceId": {
          "$ref": "#/$defs/hash"
        },
        "alt": {
          "type": "string",
          "minLength": 1
        },
        "rotation": {
          "type": "integer",
          "enum": [0, 90, 180, 270]
        },
        "thumbnail": {
          "$ref": "#/$defs/variant"
        },
        "full": {
          "$ref": "#/$defs/variant"
        }
      }
    },
    "generatedAlbum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "photos"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "photos": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/generatedImage"
          }
        }
      }
    }
  }
}
